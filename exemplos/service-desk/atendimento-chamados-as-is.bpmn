        <di:waypoint x="785" y="485" />
        <di:waypoint x="785" y="510" />
        <di:waypoint x="880" y="510" />
        <bpmndi:BPMNLabel><dc:Bounds x="790" y="492" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="980" y="510" />
        <di:waypoint x="1080" y="510" />
        <di:waypoint x="1080" y="590" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="980" y="410" />
        <di:waypoint x="1180" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1130" y="630" />
