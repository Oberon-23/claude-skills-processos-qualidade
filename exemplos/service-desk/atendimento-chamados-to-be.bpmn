      <bpmndi:BPMNShape id="B_SLA_di" bpmnElement="B_SLA"><dc:Bounds x="922" y="572" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="856" y="594" width="62" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_Legenda_di" bpmnElement="Ann_Legenda"><dc:Bounds x="200" y="720" width="620" height="40" /></bpmndi:BPMNShape>
