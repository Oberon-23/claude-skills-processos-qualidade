<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_1"><bpmn:participant id="Pool_1" name="Processo de compras (AS-IS)" processRef="Process_1"/></bpmn:collaboration>
<bpmn:process id="Process_1" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="Lane_0" name="Solicitante">
<bpmn:flowNodeRef>start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_req</bpmn:flowNodeRef>
<bpmn:flowNodeRef>end_rej</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_1" name="Gestor / Diretoria">
<bpmn:flowNodeRef>t_aprova</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g_apr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_dir</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_2" name="Compras">
<bpmn:flowNodeRef>g_comp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_cota</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_comp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_neg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g_alc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_ped</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_div</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_3" name="Estoque">
<bpmn:flowNodeRef>t_rec</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g_ent</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_4" name="Financeiro">
<bpmn:flowNodeRef>t_nf</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g_bate</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_ag</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_pag</bpmn:flowNodeRef>
<bpmn:flowNodeRef>end</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="start" name="Necessidade de material">
<bpmn:outgoing>f1</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:task id="t_req" name="Preencher requisição">
<bpmn:documentation>GARGALO 1 (retrabalho): requisição chega incompleta (sem especificação, quantidade, prazo ou centro de custo) e volta ao solicitante.
AUTOMAÇÃO: formulário com campos obrigatórios (Forms/Google Forms) que já cria o registro.</bpmn:documentation>
<bpmn:incoming>f1</bpmn:incoming>
<bpmn:incoming>f3</bpmn:incoming>
<bpmn:outgoing>f2</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="g_comp" name="Requisição completa?">
<bpmn:incoming>f2</bpmn:incoming>
<bpmn:outgoing>f3</bpmn:outgoing>
<bpmn:outgoing>f4</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="t_aprova" name="Aprovar requisição">
<bpmn:documentation>Espera: aprovador ocupado ou ausente.
AUTOMAÇÃO: fluxo de aprovação com lembrete e substituto (Power Automate / ERP).</bpmn:documentation>
<bpmn:incoming>f4</bpmn:incoming>
<bpmn:outgoing>f5</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="g_apr" name="Aprovado?">
<bpmn:incoming>f5</bpmn:incoming>
<bpmn:outgoing>f6</bpmn:outgoing>
<bpmn:outgoing>f7</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="end_rej" name="Requisição recusada">
<bpmn:incoming>f6</bpmn:incoming>
</bpmn:endEvent>
<bpmn:task id="t_cota" name="Pedir cotações aos fornecedores">
<bpmn:documentation>GARGALO 2 (espera): pedidos por e-mail/telefone, um fornecedor lento trava a comparação.
AUTOMAÇÃO: e-mail padrão enviado a todos em paralelo, com prazo-limite; depois portal/módulo de cotação do ERP.</bpmn:documentation>
<bpmn:incoming>f7</bpmn:incoming>
<bpmn:outgoing>f8</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="t_comp" name="Comparar propostas na planilha">
<bpmn:documentation>GARGALO 2 (processamento em excesso): redigitação das propostas na planilha.
AUTOMAÇÃO: formulário de resposta do fornecedor que alimenta a planilha/Power Query.</bpmn:documentation>
<bpmn:incoming>f8</bpmn:incoming>
<bpmn:outgoing>f9</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="t_neg" name="Negociar e escolher fornecedor">
<bpmn:documentation>Etapa que agrega valor. Itens recorrentes podem pular a cotação (preço de contrato com fornecedor homologado).</bpmn:documentation>
<bpmn:incoming>f9</bpmn:incoming>
<bpmn:outgoing>f10</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="g_alc" name="Acima da alçada?">
<bpmn:incoming>f10</bpmn:incoming>
<bpmn:outgoing>f11</bpmn:outgoing>
<bpmn:outgoing>f12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="t_dir" name="Diretoria aprova a compra">
<bpmn:documentation>Espera por aprovação. AUTOMAÇÃO: alçada por valor com roteamento automático e substituto.</bpmn:documentation>
<bpmn:incoming>f11</bpmn:incoming>
<bpmn:outgoing>f13</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="t_ped" name="Emitir pedido de compra">
<bpmn:documentation>Redigitação dos dados da cotação.
AUTOMAÇÃO: gerar o pedido a partir da cotação vencedora (ERP ou macro).</bpmn:documentation>
<bpmn:incoming>f12</bpmn:incoming>
<bpmn:incoming>f13</bpmn:incoming>
<bpmn:outgoing>f14</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="t_rec" name="Receber e conferir material">
<bpmn:documentation>Espera: NF física chega depois da entrega.
AUTOMAÇÃO: conferência contra o pedido em sistema/leitura do XML da NF-e.</bpmn:documentation>
<bpmn:incoming>f14</bpmn:incoming>
<bpmn:incoming>f17</bpmn:incoming>
<bpmn:outgoing>f15</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="g_ent" name="Entrega confere?">
<bpmn:incoming>f15</bpmn:incoming>
<bpmn:outgoing>f16</bpmn:outgoing>
<bpmn:outgoing>f18</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="t_div" name="Tratar divergência com fornecedor">
<bpmn:documentation>Retrabalho e atraso no pagamento.
AUTOMAÇÃO: alerta automático de divergência com o motivo (preço/quantidade).</bpmn:documentation>
<bpmn:incoming>f16</bpmn:incoming>
<bpmn:incoming>f20</bpmn:incoming>
<bpmn:outgoing>f17</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="t_nf" name="Conferir NF (3 vias)">
<bpmn:documentation>GARGALO 3 (retrabalho/redigitação): conferência manual de pedido x recebimento x NF.
AUTOMAÇÃO: regra no ERP com tolerância (ex.: ±2%) ou script/Power Query lendo o XML da NF-e; só exceção vai para pessoa.</bpmn:documentation>
<bpmn:incoming>f18</bpmn:incoming>
<bpmn:outgoing>f19</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="g_bate" name="Bate?">
<bpmn:incoming>f19</bpmn:incoming>
<bpmn:outgoing>f20</bpmn:outgoing>
<bpmn:outgoing>f21</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="t_ag" name="Agendar pagamento">
<bpmn:documentation>AUTOMAÇÃO: agenda de vencimentos integrada ao banco, para evitar multa.</bpmn:documentation>
<bpmn:incoming>f21</bpmn:incoming>
<bpmn:outgoing>f22</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="t_pag" name="Pagar e conciliar">
<bpmn:documentation>AUTOMAÇÃO: conciliação bancária automática.</bpmn:documentation>
<bpmn:incoming>f22</bpmn:incoming>
<bpmn:outgoing>f23</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="end" name="Fornecedor pago">
<bpmn:incoming>f23</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_req"/>
<bpmn:sequenceFlow id="f2" sourceRef="t_req" targetRef="g_comp"/>
<bpmn:sequenceFlow id="f3" sourceRef="g_comp" targetRef="t_req" name="Não"/>
<bpmn:sequenceFlow id="f4" sourceRef="g_comp" targetRef="t_aprova" name="Sim"/>
<bpmn:sequenceFlow id="f5" sourceRef="t_aprova" targetRef="g_apr"/>
<bpmn:sequenceFlow id="f6" sourceRef="g_apr" targetRef="end_rej" name="Não"/>
<bpmn:sequenceFlow id="f7" sourceRef="g_apr" targetRef="t_cota" name="Sim"/>
<bpmn:sequenceFlow id="f8" sourceRef="t_cota" targetRef="t_comp"/>
<bpmn:sequenceFlow id="f9" sourceRef="t_comp" targetRef="t_neg"/>
<bpmn:sequenceFlow id="f10" sourceRef="t_neg" targetRef="g_alc"/>
<bpmn:sequenceFlow id="f11" sourceRef="g_alc" targetRef="t_dir" name="Sim"/>
<bpmn:sequenceFlow id="f12" sourceRef="g_alc" targetRef="t_ped" name="Não"/>
<bpmn:sequenceFlow id="f13" sourceRef="t_dir" targetRef="t_ped"/>
<bpmn:sequenceFlow id="f14" sourceRef="t_ped" targetRef="t_rec"/>
<bpmn:sequenceFlow id="f15" sourceRef="t_rec" targetRef="g_ent"/>
<bpmn:sequenceFlow id="f16" sourceRef="g_ent" targetRef="t_div" name="Não"/>
<bpmn:sequenceFlow id="f17" sourceRef="t_div" targetRef="t_rec"/>
<bpmn:sequenceFlow id="f18" sourceRef="g_ent" targetRef="t_nf" name="Sim"/>
<bpmn:sequenceFlow id="f19" sourceRef="t_nf" targetRef="g_bate"/>
<bpmn:sequenceFlow id="f20" sourceRef="g_bate" targetRef="t_div" name="Não"/>
<bpmn:sequenceFlow id="f21" sourceRef="g_bate" targetRef="t_ag" name="Sim"/>
<bpmn:sequenceFlow id="f22" sourceRef="t_ag" targetRef="t_pag"/>
<bpmn:sequenceFlow id="f23" sourceRef="t_pag" targetRef="end"/>
</bpmn:process>
